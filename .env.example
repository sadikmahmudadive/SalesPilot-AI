# SalesPilot AI environment variables. Copy to .env.local and fill in real values.
# NEVER commit .env.local or any real credential. Only this file is tracked.
# Legend: [required|optional] [public|secret]
#   public  = exposed to the browser (NEXT_PUBLIC_*), never put secrets here
#   secret  = server-only
# `process.env` is read only in src/config/env.ts (server) and src/config/env.client.ts (public).

# ---------------------------------------------------------------- App
# [required, public] Base URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [optional, secret] session cookie lifetime in days, integer 1-14 (default 5)
SESSION_COOKIE_MAX_DAYS=

# ---------------------------------------------------------------- Firebase client SDK
# [required, public]
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------- Firebase Admin SDK
# [required, secret] service account credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# keep literal \n sequences inside the quoted key
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------- OpenAI
# [optional, secret] required only for AI features
OPENAI_API_KEY=
# [optional, secret] model names
OPENAI_CHAT_MODEL=
OPENAI_REALTIME_MODEL=

# ---------------------------------------------------------------- Cloudinary
# [optional, secret] required only for media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------- WhatsApp Cloud API (Meta)
# [optional, secret] required only for the WhatsApp integration
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# [optional, secret] Graph API version, e.g. v21.0
META_GRAPH_API_VERSION=

# ---------------------------------------------------------------- Twilio (voice)
# [optional, secret] required only for the voice integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_SECRET=

# ---------------------------------------------------------------- SSLCommerz (payments)
# [optional, secret] required only for payments
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# true for live, false for sandbox
SSLCOMMERZ_IS_LIVE=false

# ---------------------------------------------------------------- n8n automation
# [optional, secret] required only for n8n workflows
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Security
# [required, secret] key for encrypting stored integration credentials (32 bytes, base64)
ENCRYPTION_KEY=
# [required, secret] shared secret authorising cron endpoint calls
CRON_SECRET=

# ---------------------------------------------------------------- Local emulators (dev/test only)
# [optional, public] set to true to point the Firebase client SDK at local emulators
NEXT_PUBLIC_USE_EMULATORS=false
# [optional, secret] emulator hosts (Firestore 8085, Auth 9199). Do NOT set these in
# .env.local for production. They are set automatically by the committed
# .env.development (next dev) and by `firebase emulators:exec` (npm run test:int).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9199
