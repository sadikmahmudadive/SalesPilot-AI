# Committed on purpose: public demo values for local development against the Firebase
# emulators. NO secrets here. Real credentials go in .env.local (git-ignored).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-salespilot.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-salespilot
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-salespilot.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_USE_EMULATORS=true

FIREBASE_PROJECT_ID=demo-salespilot
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9199
